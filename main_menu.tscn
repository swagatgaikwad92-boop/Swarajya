[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1"]

[node name="MainMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Bg" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.11, 0.09, 0.07, 1)

[node name="VBox" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -240.0
offset_right = 240.0
offset_bottom = 260.0
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="VBox"]
theme_override_font_sizes/font_size = 36
theme_override_colors/font_color = Color(0.9, 0.8, 0.62, 1)
text = "SWARAJYA"
horizontal_alignment = 1

[node name="Sub" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(0.8, 0.75, 0.66, 1)
text = "THE MARATHA AGE
Version 0.2  —  Era I vertical slice
BUILD SWARAJYA. COMMAND THE DECCAN."
horizontal_alignment = 1

[node name="New" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 48)
text = "New Campaign"

[node name="Continue" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 48)
text = "Continue"

[node name="Codex" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 48)
text = "Historical Atlas"

[node name="Note" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(0.7, 0.66, 0.58, 1)
text = "Era II and Era III are planned and locked.
Historical notes are separated from gameplay numbers."
autowrap_mode = 3
horizontal_alignment = 1

[connection signal="pressed" from="VBox/New" to="." method="_on_new_pressed"]
[connection signal="pressed" from="VBox/Continue" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="VBox/Codex" to="." method="_on_codex"]
